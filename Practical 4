# Create empty board
board = ["" for _ in range(9)]

# Print board
def print_board(b):
    for i in range(0, 9, 3):
        row = [b[j] if b[j] else " " for j in range(i, i+3)]
        print(" | ".join(row))
        if i < 6:
            print("---+---+---")

# Check winner
def check_winner(b, player):
    win = [
        [0,1,2], [3,4,5], [6,7,8],
        [0,3,6], [1,4,7], [2,5,8],
        [0,4,8], [2,4,6]
    ]

    return any(all(b[i] == player for i in c) for c in win)

# Check draw
def is_draw(b):
    return "" not in b and not check_winner(b, "O") and not check_winner(b, "X")

print("Initial Board:")
print_board(board)

# Minimax with Alpha-Beta pruning
def minimax(b, maximizing, alpha, beta):
    if check_winner(b, "O"):
        return 1
    if check_winner(b, "X"):
        return -1
    if "" not in b:
        return 0

    if maximizing:
        best = -float("inf")

        for i in range(9):
            if b[i] == "":
                b[i] = "O"
                score = minimax(b, False, alpha, beta)
                b[i] = ""

                best = max(best, score)
                alpha = max(alpha, score)

                if beta <= alpha:
                    break

        return best

    else:
        best = float("inf")

        for i in range(9):
            if b[i] == "":
                b[i] = "X"
                score = minimax(b, True, alpha, beta)
                b[i] = ""

                best = min(best, score)
                beta = min(beta, score)

                if beta <= alpha:
                    break

        return best

# Find best move
def best_move(b):
    best = -float("inf")
    move = None

    for i in range(9):
        if b[i] == "":
            b[i] = "O"
            score = minimax(b, False, -float("inf"), float("inf"))
            b[i] = ""

            if score > best:
                best = score
                move = i

    return move

# Simulate game
sample_moves = [4, 0, 2, 7]
sim_board = ["" for _ in range(9)]

print("--- Game Trace ---")

for h_move in sample_moves:
    sim_board[h_move] = "X"
    print("Human plays:", h_move)

    if check_winner(sim_board, "X") or is_draw(sim_board):
        break

    ai_pos = best_move(sim_board)
    sim_board[ai_pos] = "O"

    print("AI plays:", ai_pos)
    print_board(sim_board)
    print("-" * 15)

    if check_winner(sim_board, "O") or is_draw(sim_board):
        break

if check_winner(sim_board, "O"):
    print("Result: AI Wins!")
elif check_winner(sim_board, "X"):
    print("Result: Human Wins!")
else:
    print("Result: Draw!")
