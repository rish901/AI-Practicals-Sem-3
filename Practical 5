# Knowledge base
facts = [
    ("Aarav", "Priya"),
    ("Priya", "Rohit"),
    ("Sneha", "Priya"),
    ("Rohit", "Kavya")
]

# Check direct manager
def is_parent(child, parent):
    return (child, parent) in facts

# Check ancestor
def is_ancestor(person, ancestor, visited=None):
    if visited is None:
        visited = set()

    for child, parent in facts:
        if child == person and parent not in visited:
            if parent == ancestor:
                return True

            visited.add(parent)

            if is_ancestor(parent, ancestor, visited):
                return True

    return False

print("Is Priya direct manager of Aarav?",
      is_parent("Aarav", "Priya"))

print("Is Rohit direct manager of Aarav?",
      is_parent("Aarav", "Rohit"))

print("Is Rohit an ancestor of Aarav?",
      is_ancestor("Aarav", "Rohit"))

print("Is Kavya an ancestor of Aarav?",
      is_ancestor("Aarav", "Kavya"))

# Forward chaining
def forward_chain(facts):
    derived = set(facts)
    changed = True

    while changed:
        changed = False
        new_facts = set()

        for a, b in derived:
            for c, d in derived:
                if b == c and (a, d) not in derived:
                    new_facts.add((a, d))

        if new_facts:
            derived.update(new_facts)
            changed = True

    return derived

all_relationships = forward_chain(facts)

print("All reporting relationships:")
for rel in sorted(all_relationships):
    print(rel[0], "reports up to", rel[1])

# Backward chaining
def backward_chain(child, ancestor, facts, trace=None):
    if trace is None:
        trace = []

    for c, p in facts:
        if c == child:
            trace.append("Checking: " + c + " -> " + p)

            if p == ancestor:
                trace.append("Match found!")
                return True, trace

            result, trace = backward_chain(
                p, ancestor, facts, trace
            )

            if result:
                return True, trace

    return False, trace

result, trace = backward_chain("Aarav", "Kavya", facts)

print("Query Result:", result)
print("Reasoning steps:")

for step in trace:
    print(step)
